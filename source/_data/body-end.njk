<div class="sidebar-music" id="sidebar-music">
  <div class="sidebar-music-head">
    <span class="sidebar-music-brand"><i class="fa fa-headphones"></i> NEMO FM</span>
    <button type="button" class="sidebar-music-status" id="nemo-music-status" aria-live="polite">连接中</button>
  </div>
  <div class="nemo-player" id="nemo-player">
    <div class="nemo-player-loading">正在连接音乐源…</div>
  </div>
</div>
<script>
  (function () {
    var sidebar = document.querySelector('.sidebar');
    var music = document.getElementById('sidebar-music');
    if (!sidebar || !music) return;
    sidebar.appendChild(music);
  })();
</script>
<script src="/js/nemo-player.js?v=1"></script>
